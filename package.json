    "@types/node": "22.10.2",
    "@types/three": "0.170.0",
    "meshoptimizer": "0.22.0",
    "playwright": "1.49.1",
    "pngjs": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "5.4.11"

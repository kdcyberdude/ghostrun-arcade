import fs from 'node:fs';import path from 'node:path';import {parseArgs} from 'node:util';import {pathToFileURL} from 'node:url';import {createHash} from 'node:crypto';import {execFileSync} from 'node:child_process';
const {values:a}=parseArgs({options:{worktree:{type:'string'},'baseline-ref':{type:'string'},out:{type:'string'}}});for(const k of ['worktree','baseline-ref','out'] as const)if(!a[k])throw Error(`--${k} required`);
const game=path.join(a.worktree!,'games/smb'),dir=path.join(game,'evidence/native-runs'),{excerptReplay}=await import(pathToFileURL(path.join(game,'tools/harness/native-excerpt.ts')).href);
const files=fs.readdirSync(dir).filter(n=>/^([567])-2\.water-(down-strokes|reverse|right-strokes)\.json$/.test(n)).sort();if(files.length!==9)throw Error(`Expected exactly9 water excerpts, got${files.length}`);
const hash=(x:any)=>createHash('sha256').update(JSON.stringify(x)).digest('hex'),payload=(x:any)=>{const y={...x};delete y.firsts;return y;},excerpts=[];
for(const file of files){const target=path.join(dir,file),x=JSON.parse(fs.readFileSync(target,'utf8')),old=JSON.parse(execFileSync('git',['show',`${a['baseline-ref']}:games/smb/evidence/native-runs/${file}`],{cwd:a.worktree,encoding:'utf8'}));if(x.schema!=='native-run-excerpt-v2'||old.schema!==x.schema)throw Error(`Unexpected excerpt schema${file}`);const payloadBefore=hash(payload(x)),previousFirsts=x.firsts,candidateFirsts=excerptReplay(x).fields;x.firsts=candidateFirsts;const text=JSON.stringify(x)+'\n',payloadAfter=hash(payload(JSON.parse(text)));if(payloadBefore!==payloadAfter)throw Error(`Payload mutation${file}`);fs.writeFileSync(target,text);excerpts.push({file,level:x.level,run:x.run,baselineFirsts:old.firsts,previousFirsts,candidateFirsts,baselinePayload:hash(payload(old)),payloadBefore,payloadAfter});}
fs.writeFileSync(a.out!,JSON.stringify({schema:'smb-water-excerpt-ratchet-v1',baselineRef:a['baseline-ref'],excerpts},null,2)+'\n');console.log(`Replayed9 water excerpts; all encoded source payloads unchanged`);
